
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# MySQL Primary Operational Database (Transactional Storage)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agroassist
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# ------------------------------------------------------------------------------
# Snowflake Analytics Warehouse (Historical Tracking & Analytical Queries)
# ------------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier
SNOWFLAKE_USERNAME=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password_here
SNOWFLAKE_DATABASE=AGROASSIST_DW
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# ------------------------------------------------------------------------------
# Cloudinary Storage & Media Service (Crop & Disease Scan Uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Google Gemini AI Engine (Crop Diagnosis & Advisory Generation)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# OpenWeatherMap API (Micro-climate Weather Data)
# ------------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ------------------------------------------------------------------------------
# JWT Authentication & Authorization
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_super_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Google OAuth Integration (Optional / Feature Toggleable)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ------------------------------------------------------------------------------
# Logging & CORS Configuration (Optional Defaults)
# ------------------------------------------------------------------------------
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:5173, https://0a72be35.agroassist-4sv.pages.dev, https://agroassist-4sv.pages.dev
