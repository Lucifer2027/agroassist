    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@tailwindcss/postcss": "^4",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.39.5",
